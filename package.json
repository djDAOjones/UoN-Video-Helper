{
  "name": "uon-video-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Add approved UoN branding and consistent audio levels to an educational video, entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:placeholders",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#pm_skills\"",
    "docs:links": "node check-links.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:memory": "node pm_skills/scaffold/check-memory.mjs",
    "check": "npm run check:placeholders && npm run typecheck && npm run lint && npm run test && npm run check:build && npm run docs:lint && npm run docs:links && npm run check:memory"
  },
  "dependencies": {
    "mediabunny": "^1.55.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
